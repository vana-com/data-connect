# Required: DataConnect Privy App ID
VITE_PRIVY_APP_ID=your-privy-app-id

# Optional: DataConnect Privy Client ID for environment-specific settings
VITE_PRIVY_CLIENT_ID=your-privy-client-id

# Session Relay URL (optional, defaults to https://session-relay.vana.org)
VITE_SESSION_RELAY_URL=https://session-relay.vana.org

# Gateway URL (optional, defaults to https://data-gateway.vana.org)
VITE_GATEWAY_URL=https://data-gateway.vana.org

# Account URL
VITE_ACCOUNT_URL=https://account.vana.org

# Tunnel FRP server (default: your-tunnel-host:7000)
# VITE_TUNNEL_SERVER_ADDR=your-tunnel-host
# VITE_TUNNEL_SERVER_PORT=7000
